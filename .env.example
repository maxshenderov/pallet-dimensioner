# Индексы /dev/videoN на хосте (Raspberry Pi / mini-PC), пробрасываемые в контейнер.
# Для нескольких точек на одном хосте добавь ещё пары device-маппингов в docker-compose.yml.
CAMERA_TOP_DEVICE=/dev/video0
CAMERA_SIDE_DEVICE=/dev/video1

# Порт веб-сервиса (документация /, точки /posts, рабочее место /posts/{id}/workplace)
SERVER_PORT=8012
